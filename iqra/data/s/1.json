{"n":1,"ayahs":[{"n":1,"text":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ","tajwid":[{"r":"hamzat_wasl","s":7,"e":8},{"r":"hamzat_wasl","s":15,"e":16},{"r":"lam_shamsiyyah","s":16,"e":17},{"r":"madd_2","s":24,"e":25},{"r":"hamzat_wasl","s":28,"e":29},{"r":"lam_shamsiyyah","s":29,"e":30},{"r":"madd_246","s":35,"e":36}],"fr":"Au nom d'Allah, le Tout Miséricordieux, le Très Miséricordieux."},{"n":2,"text":"ٱلْحَمْدُ لِلَّهِ رَبِّ ٱلْعَٰلَمِينَ","tajwid":[{"r":"hamzat_wasl","s":24,"e":25},{"r":"madd_2","s":29,"e":30},{"r":"madd_246","s":34,"e":35}],"fr":"Louange à Allah, Seigneur de l'univers."},{"n":3,"text":"ٱلرَّحْمَٰنِ ٱلرَّحِيمِ","tajwid":[{"r":"lam_shamsiyyah","s":1,"e":2},{"r":"madd_2","s":9,"e":10},{"r":"hamzat_wasl","s":13,"e":14},{"r":"lam_shamsiyyah","s":14,"e":15},{"r":"madd_246","s":20,"e":21}],"fr":"Le Tout Miséricordieux, le Très Miséricordieux,"},{"n":4,"text":"مَٰلِكِ يَوْمِ ٱلدِّينِ","tajwid":[{"r":"madd_2","s":2,"e":3},{"r":"hamzat_wasl","s":15,"e":16},{"r":"lam_shamsiyyah","s":16,"e":17},{"r":"madd_246","s":20,"e":21}],"fr":"Maître du Jour de la rétribution."},{"n":5,"text":"إِيَّاكَ نَعْبُدُ وَإِيَّاكَ نَسْتَعِينُ","tajwid":[{"r":"madd_246","s":37,"e":38}],"fr":"C'est Toi [Seul] que nous adorons, et c'est Toi [Seul] dont nous implorons secours."},{"n":6,"text":"ٱهْدِنَا ٱلصِّرَٰطَ ٱلْمُسْتَقِيمَ","tajwid":[{"r":"hamzat_wasl","s":9,"e":10},{"r":"lam_shamsiyyah","s":10,"e":11},{"r":"madd_2","s":16,"e":17},{"r":"hamzat_wasl","s":20,"e":21},{"r":"madd_246","s":31,"e":32}],"fr":"Guide-nous dans le droit chemin,"},{"n":7,"text":"صِرَٰطَ ٱلَّذِينَ أَنْعَمْتَ عَلَيْهِمْ غَيْرِ ٱلْمَغْضُوبِ عَلَيْهِمْ وَلَا ٱلضَّآلِّينَ","tajwid":[{"r":"madd_2","s":4,"e":5},{"r":"hamzat_wasl","s":8,"e":9},{"r":"hamzat_wasl","s":47,"e":48},{"r":"hamzat_wasl","s":77,"e":78},{"r":"lam_shamsiyyah","s":78,"e":79},{"r":"madd_6","s":82,"e":84},{"r":"madd_246","s":87,"e":88}],"fr":"le chemin de ceux que Tu as comblés de faveurs, non pas de ceux qui ont encouru Ta colère, ni des égarés."}]}