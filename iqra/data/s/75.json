{"n":75,"ayahs":[{"n":1,"text":"لَآ أُقْسِمُ بِيَوْمِ ٱلْقِيَٰمَةِ","tajwid":[{"r":"madd_munfasil","s":2,"e":4},{"r":"qalqalah","s":7,"e":9},{"r":"hamzat_wasl","s":23,"e":24},{"r":"madd_2","s":30,"e":31}],"fr":"Non!... Je jure par le Jour de la Résurrection!"},{"n":2,"text":"وَلَآ أُقْسِمُ بِٱلنَّفْسِ ٱللَّوَّامَةِ","tajwid":[{"r":"madd_munfasil","s":4,"e":6},{"r":"qalqalah","s":9,"e":11},{"r":"hamzat_wasl","s":18,"e":19},{"r":"lam_shamsiyyah","s":19,"e":20},{"r":"ghunnah","s":20,"e":23},{"r":"hamzat_wasl","s":28,"e":29},{"r":"lam_shamsiyyah","s":29,"e":30}],"fr":"Mais non!, Je jure par l'âme qui ne cesse de se blâmer."},{"n":3,"text":"أَيَحْسَبُ ٱلْإِنسَٰنُ أَلَّن نَّجْمَعَ عِظَامَهُۥ","tajwid":[{"r":"hamzat_wasl","s":11,"e":12},{"r":"ikhfa","s":16,"e":19},{"r":"madd_2","s":19,"e":20},{"r":"idghaam_ghunnah","s":28,"e":33},{"r":"qalqalah","s":33,"e":35}],"fr":"L'homme, pense-t-il que Nous ne réunirons jamais ses os?"},{"n":4,"text":"بَلَىٰ قَٰدِرِينَ عَلَىٰٓ أَن نُّسَوِّىَ بَنَانَهُۥ","tajwid":[{"r":"madd_2","s":9,"e":10},{"r":"madd_munfasil","s":22,"e":25},{"r":"idghaam_ghunnah","s":28,"e":33}],"fr":"Mais si! Nous sommes Capable de remettre à leur place les extrémités de ses doigts."},{"n":5,"text":"بَلْ يُرِيدُ ٱلْإِنسَٰنُ لِيَفْجُرَ أَمَامَهُۥ","tajwid":[{"r":"hamzat_wasl","s":13,"e":14},{"r":"ikhfa","s":18,"e":21},{"r":"madd_2","s":21,"e":22}],"fr":"L'homme voudrait plutôt continuer à vivre en libertin."},{"n":6,"text":"يَسْـَٔلُ أَيَّانَ يَوْمُ ٱلْقِيَٰمَةِ","tajwid":[{"r":"hamzat_wasl","s":26,"e":27},{"r":"madd_2","s":33,"e":34}],"fr":"Il interroge: «A quand, le Jour de la Résurrection?»"},{"n":7,"text":"فَإِذَا بَرِقَ ٱلْبَصَرُ","tajwid":[{"r":"hamzat_wasl","s":15,"e":16}],"fr":"Lorsque la vue sera éblouie,"},{"n":8,"text":"وَخَسَفَ ٱلْقَمَرُ","tajwid":[{"r":"hamzat_wasl","s":9,"e":10}],"fr":"et que la lune s'éclipsera,"},{"n":9,"text":"وَجُمِعَ ٱلشَّمْسُ وَٱلْقَمَرُ","tajwid":[{"r":"hamzat_wasl","s":9,"e":10},{"r":"lam_shamsiyyah","s":10,"e":11},{"r":"hamzat_wasl","s":21,"e":22}],"fr":"et que le soleil et la lune seront réunis,"},{"n":10,"text":"يَقُولُ ٱلْإِنسَٰنُ يَوْمَئِذٍ أَيْنَ ٱلْمَفَرُّ","tajwid":[{"r":"hamzat_wasl","s":8,"e":9},{"r":"ikhfa","s":13,"e":16},{"r":"madd_2","s":16,"e":17},{"r":"hamzat_wasl","s":38,"e":39}],"fr":"l'homme, ce jour-là, dira: «Où fuir?»"},{"n":11,"text":"كَلَّا لَا وَزَرَ","tajwid":[],"fr":"Non! Point de refuge!"},{"n":12,"text":"إِلَىٰ رَبِّكَ يَوْمَئِذٍ ٱلْمُسْتَقَرُّ","tajwid":[{"r":"hamzat_wasl","s":26,"e":27}],"fr":"Vers ton Seigneur sera, ce jour-là, le retour."},{"n":13,"text":"يُنَبَّؤُا۟ ٱلْإِنسَٰنُ يَوْمَئِذٍۭ بِمَا قَدَّمَ وَأَخَّرَ","tajwid":[{"r":"silent","s":9,"e":11},{"r":"hamzat_wasl","s":12,"e":13},{"r":"ikhfa","s":17,"e":20},{"r":"madd_2","s":20,"e":21},{"r":"iqlab","s":33,"e":37}],"fr":"L'homme sera informé ce jour-là de ce qu'il aura avancé et de ce qu'il aura remis à plus tard."},{"n":14,"text":"بَلِ ٱلْإِنسَٰنُ عَلَىٰ نَفْسِهِۦ بَصِيرَةٌ","tajwid":[{"r":"hamzat_wasl","s":5,"e":6},{"r":"ikhfa","s":10,"e":13},{"r":"madd_2","s":13,"e":14},{"r":"madd_2","s":32,"e":33}],"fr":"Mais l'homme sera un témoin perspicace contre lui-même,"},{"n":15,"text":"وَلَوْ أَلْقَىٰ مَعَاذِيرَهُۥ","tajwid":[],"fr":"quand même il présenterait ses excuses."},{"n":16,"text":"لَا تُحَرِّكْ بِهِۦ لِسَانَكَ لِتَعْجَلَ بِهِۦٓ","tajwid":[{"r":"madd_2","s":18,"e":19}],"fr":"Ne remue pas ta langue pour hâter sa récitation:"},{"n":17,"text":"إِنَّ عَلَيْنَا جَمْعَهُۥ وَقُرْءَانَهُۥ","tajwid":[{"r":"ghunnah","s":2,"e":5},{"r":"madd_2","s":24,"e":25}],"fr":"Son rassemblement (dans ton cœur et sa fixation dans ta mémoire) Nous incombent, ainsi que la façon de le réciter."},{"n":18,"text":"فَإِذَا قَرَأْنَٰهُ فَٱتَّبِعْ قُرْءَانَهُۥ","tajwid":[{"r":"madd_2","s":16,"e":17},{"r":"hamzat_wasl","s":22,"e":23}],"fr":"Quand donc Nous le récitons, suis sa récitation."},{"n":19,"text":"ثُمَّ إِنَّ عَلَيْنَا بَيَانَهُۥ","tajwid":[{"r":"ghunnah","s":2,"e":5},{"r":"ghunnah","s":8,"e":11}],"fr":"A Nous, ensuite incombera son explication."},{"n":20,"text":"كَلَّا بَلْ تُحِبُّونَ ٱلْعَاجِلَةَ","tajwid":[{"r":"hamzat_wasl","s":23,"e":24}],"fr":"Mais vous aimez plutôt [la vie] éphémère,"},{"n":21,"text":"وَتَذَرُونَ ٱلْءَاخِرَةَ","tajwid":[{"r":"hamzat_wasl","s":12,"e":13}],"fr":"et vous délaissez l'au-delà."},{"n":22,"text":"وُجُوهٌ يَوْمَئِذٍ نَّاضِرَةٌ","tajwid":[{"r":"idghaam_ghunnah","s":6,"e":10},{"r":"idghaam_ghunnah","s":17,"e":22}],"fr":"Ce jour-là, il y aura des visages resplendissants"},{"n":23,"text":"إِلَىٰ رَبِّهَا نَاظِرَةٌ","tajwid":[],"fr":"qui regarderont leur Seigneur;"},{"n":24,"text":"وَوُجُوهٌ يَوْمَئِذٍۭ بَاسِرَةٌ","tajwid":[{"r":"idghaam_ghunnah","s":8,"e":12},{"r":"iqlab","s":19,"e":23}],"fr":"et il y aura ce jour-là, des visages assombris,"},{"n":25,"text":"تَظُنُّ أَن يُفْعَلَ بِهَا فَاقِرَةٌ","tajwid":[{"r":"ghunnah","s":4,"e":7},{"r":"idghaam_ghunnah","s":10,"e":14}],"fr":"qui s'attendent à subir une catastrophe."},{"n":26,"text":"كَلَّآ إِذَا بَلَغَتِ ٱلتَّرَاقِىَ","tajwid":[{"r":"madd_munfasil","s":5,"e":7},{"r":"hamzat_wasl","s":23,"e":24},{"r":"lam_shamsiyyah","s":24,"e":25}],"fr":"Mais non! Quand [l'âme] en arrive aux clavicules"},{"n":27,"text":"وَقِيلَ مَنْ رَاقٍ","tajwid":[{"r":"madd_246","s":15,"e":16},{"r":"qalqalah","s":16,"e":17}],"fr":"et qu'on dit: «Qui est exorciseur?»"},{"n":28,"text":"وَظَنَّ أَنَّهُ ٱلْفِرَاقُ","tajwid":[{"r":"ghunnah","s":4,"e":7},{"r":"ghunnah","s":10,"e":13},{"r":"hamzat_wasl","s":16,"e":17},{"r":"madd_246","s":23,"e":24},{"r":"qalqalah","s":24,"e":25}],"fr":"et qu'il [l'agonisant] est convaincu que c'est la séparation (la mort),"},{"n":29,"text":"وَٱلْتَفَّتِ ٱلسَّاقُ بِٱلسَّاقِ","tajwid":[{"r":"hamzat_wasl","s":2,"e":3},{"r":"hamzat_wasl","s":13,"e":14},{"r":"lam_shamsiyyah","s":14,"e":15},{"r":"hamzat_wasl","s":24,"e":25},{"r":"lam_shamsiyyah","s":25,"e":26},{"r":"madd_246","s":29,"e":30},{"r":"qalqalah","s":30,"e":31}],"fr":"et que la jambe s'enlace à la jambe,"},{"n":30,"text":"إِلَىٰ رَبِّكَ يَوْمَئِذٍ ٱلْمَسَاقُ","tajwid":[{"r":"hamzat_wasl","s":26,"e":27},{"r":"madd_246","s":33,"e":34},{"r":"qalqalah","s":34,"e":35}],"fr":"c'est vers ton Seigneur, ce jour-là que tu seras conduit."},{"n":31,"text":"فَلَا صَدَّقَ وَلَا صَلَّىٰ","tajwid":[],"fr":"Mais il n'a ni cru, ni fait la Salât;"},{"n":32,"text":"وَلَٰكِن كَذَّبَ وَتَوَلَّىٰ","tajwid":[{"r":"madd_2","s":4,"e":5},{"r":"ikhfa","s":7,"e":11}],"fr":"par contre, il a démenti et tourné le dos,"},{"n":33,"text":"ثُمَّ ذَهَبَ إِلَىٰٓ أَهْلِهِۦ يَتَمَطَّىٰٓ","tajwid":[{"r":"ghunnah","s":2,"e":5},{"r":"madd_munfasil","s":17,"e":20},{"r":"madd_2","s":29,"e":30}],"fr":"puis il s'en est allé vers sa famille, marchant avec orgueil."},{"n":34,"text":"أَوْلَىٰ لَكَ فَأَوْلَىٰ","tajwid":[],"fr":"«Malheur à toi, malheur!»"},{"n":35,"text":"ثُمَّ أَوْلَىٰ لَكَ فَأَوْلَىٰٓ","tajwid":[{"r":"ghunnah","s":2,"e":5}],"fr":"Et encore malheur à toi, malheur!"},{"n":36,"text":"أَيَحْسَبُ ٱلْإِنسَٰنُ أَن يُتْرَكَ سُدًى","tajwid":[{"r":"hamzat_wasl","s":11,"e":12},{"r":"ikhfa","s":16,"e":19},{"r":"madd_2","s":19,"e":20},{"r":"idghaam_ghunnah","s":25,"e":29}],"fr":"L'homme pense-t-il qu'on le laissera sans obligation à observer?"},{"n":37,"text":"أَلَمْ يَكُ نُطْفَةً مِّن مَّنِىٍّ يُمْنَىٰ","tajwid":[{"r":"qalqalah","s":14,"e":16},{"r":"idghaam_ghunnah","s":19,"e":24},{"r":"idghaam_ghunnah","s":24,"e":29},{"r":"idghaam_ghunnah","s":33,"e":37}],"fr":"N'était-il pas une goutte de sperme éjaculé?"},{"n":38,"text":"ثُمَّ كَانَ عَلَقَةً فَخَلَقَ فَسَوَّىٰ","tajwid":[{"r":"ghunnah","s":2,"e":5},{"r":"ikhfa","s":19,"e":23}],"fr":"Et ensuite une adhérence Puis [Allah] l'a créée et formée harmonieusement;"},{"n":39,"text":"فَجَعَلَ مِنْهُ ٱلزَّوْجَيْنِ ٱلذَّكَرَ وَٱلْأُنثَىٰٓ","tajwid":[{"r":"hamzat_wasl","s":16,"e":17},{"r":"lam_shamsiyyah","s":17,"e":18},{"r":"hamzat_wasl","s":30,"e":31},{"r":"lam_shamsiyyah","s":31,"e":32},{"r":"hamzat_wasl","s":42,"e":43},{"r":"ikhfa","s":47,"e":50}],"fr":"puis en a fait alors les deux éléments de couple: le mâle et la femelle?"},{"n":40,"text":"أَلَيْسَ ذَٰلِكَ بِقَٰدِرٍ عَلَىٰٓ أَن يُحْۦِىَ ٱلْمَوْتَىٰ","tajwid":[{"r":"madd_2","s":11,"e":12},{"r":"madd_2","s":21,"e":22},{"r":"madd_munfasil","s":31,"e":34},{"r":"idghaam_ghunnah","s":37,"e":41},{"r":"hamzat_wasl","s":48,"e":49}],"fr":"Celui-là [Allah] n'est-Il pas capable de faire revivre les morts?"}]}