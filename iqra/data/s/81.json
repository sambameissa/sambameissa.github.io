{"n":81,"ayahs":[{"n":1,"text":"إِذَا ٱلشَّمْسُ كُوِّرَتْ","tajwid":[{"r":"hamzat_wasl","s":6,"e":7},{"r":"lam_shamsiyyah","s":7,"e":8}],"fr":"Quand le soleil sera obscurci,"},{"n":2,"text":"وَإِذَا ٱلنُّجُومُ ٱنكَدَرَتْ","tajwid":[{"r":"hamzat_wasl","s":8,"e":9},{"r":"lam_shamsiyyah","s":9,"e":10},{"r":"ghunnah","s":10,"e":13},{"r":"hamzat_wasl","s":19,"e":20},{"r":"ikhfa","s":20,"e":23}],"fr":"et que les étoiles deviendront ternes,"},{"n":3,"text":"وَإِذَا ٱلْجِبَالُ سُيِّرَتْ","tajwid":[{"r":"hamzat_wasl","s":8,"e":9}],"fr":"et les montagnes mises en marche,"},{"n":4,"text":"وَإِذَا ٱلْعِشَارُ عُطِّلَتْ","tajwid":[{"r":"hamzat_wasl","s":8,"e":9}],"fr":"et les chamelles à terme, négligées,"},{"n":5,"text":"وَإِذَا ٱلْوُحُوشُ حُشِرَتْ","tajwid":[{"r":"hamzat_wasl","s":8,"e":9}],"fr":"et les bêtes farouches, rassemblées,"},{"n":6,"text":"وَإِذَا ٱلْبِحَارُ سُجِّرَتْ","tajwid":[{"r":"hamzat_wasl","s":8,"e":9}],"fr":"et les mers allumées,"},{"n":7,"text":"وَإِذَا ٱلنُّفُوسُ زُوِّجَتْ","tajwid":[{"r":"hamzat_wasl","s":8,"e":9},{"r":"lam_shamsiyyah","s":9,"e":10},{"r":"ghunnah","s":10,"e":13}],"fr":"et les âmes accouplées"},{"n":8,"text":"وَإِذَا ٱلْمَوْءُۥدَةُ سُئِلَتْ","tajwid":[{"r":"hamzat_wasl","s":8,"e":9},{"r":"madd_2","s":17,"e":18}],"fr":"et qu'on demandera à la fillette enterrée vivante"},{"n":9,"text":"بِأَىِّ ذَنۢبٍ قُتِلَتْ","tajwid":[{"r":"iqlab","s":11,"e":13},{"r":"ikhfa","s":13,"e":17}],"fr":"pour quel péché elle a été tuée."},{"n":10,"text":"وَإِذَا ٱلصُّحُفُ نُشِرَتْ","tajwid":[{"r":"hamzat_wasl","s":8,"e":9},{"r":"lam_shamsiyyah","s":9,"e":10}],"fr":"Et quand les feuilles seront déployées,"},{"n":11,"text":"وَإِذَا ٱلسَّمَآءُ كُشِطَتْ","tajwid":[{"r":"hamzat_wasl","s":8,"e":9},{"r":"lam_shamsiyyah","s":9,"e":10},{"r":"madd_muttasil","s":15,"e":17}],"fr":"et le ciel écorché"},{"n":12,"text":"وَإِذَا ٱلْجَحِيمُ سُعِّرَتْ","tajwid":[{"r":"hamzat_wasl","s":8,"e":9}],"fr":"et la fournaise attisée,"},{"n":13,"text":"وَإِذَا ٱلْجَنَّةُ أُزْلِفَتْ","tajwid":[{"r":"hamzat_wasl","s":8,"e":9},{"r":"ghunnah","s":13,"e":16}],"fr":"et le Paradis rapproché,"},{"n":14,"text":"عَلِمَتْ نَفْسٌ مَّآ أَحْضَرَتْ","tajwid":[{"r":"idghaam_ghunnah","s":14,"e":19},{"r":"madd_munfasil","s":19,"e":21}],"fr":"chaque âme saura ce qu'elle a présenté."},{"n":15,"text":"فَلَآ أُقْسِمُ بِٱلْخُنَّسِ","tajwid":[{"r":"madd_munfasil","s":4,"e":6},{"r":"qalqalah","s":9,"e":11},{"r":"hamzat_wasl","s":18,"e":19},{"r":"ghunnah","s":23,"e":26}],"fr":"Non!... Je jure par les planètes qui gravitent"},{"n":16,"text":"ٱلْجَوَارِ ٱلْكُنَّسِ","tajwid":[{"r":"hamzat_wasl","s":11,"e":12},{"r":"ghunnah","s":16,"e":19}],"fr":"qui courent et disparaissent"},{"n":17,"text":"وَٱلَّيْلِ إِذَا عَسْعَسَ","tajwid":[{"r":"hamzat_wasl","s":2,"e":3}],"fr":"par la nuit quand elle survient!"},{"n":18,"text":"وَٱلصُّبْحِ إِذَا تَنَفَّسَ","tajwid":[{"r":"hamzat_wasl","s":2,"e":3},{"r":"lam_shamsiyyah","s":3,"e":4},{"r":"qalqalah","s":7,"e":9}],"fr":"et par l'aube quand elle exhale son souffle!"},{"n":19,"text":"إِنَّهُۥ لَقَوْلُ رَسُولٍ كَرِيمٍ","tajwid":[{"r":"ghunnah","s":2,"e":5},{"r":"madd_2","s":7,"e":8},{"r":"ikhfa","s":24,"e":28},{"r":"madd_246","s":30,"e":31}],"fr":"Ceci [le Coran] est la parole d'un noble Messager,"},{"n":20,"text":"ذِى قُوَّةٍ عِندَ ذِى ٱلْعَرْشِ مَكِينٍ","tajwid":[{"r":"ikhfa","s":14,"e":17},{"r":"hamzat_wasl","s":22,"e":23},{"r":"madd_246","s":36,"e":37}],"fr":"doué d'une grande force, et ayant un rang élevé auprès du Maître du Trône,"},{"n":21,"text":"مُّطَاعٍ ثَمَّ أَمِينٍ","tajwid":[{"r":"ikhfa","s":7,"e":11},{"r":"ghunnah","s":11,"e":14},{"r":"madd_246","s":19,"e":20}],"fr":"obéi, là-haut, et digne de confiance."},{"n":22,"text":"وَمَا صَاحِبُكُم بِمَجْنُونٍ","tajwid":[{"r":"ikhfa_shafawi","s":15,"e":19},{"r":"qalqalah","s":21,"e":23},{"r":"madd_246","s":25,"e":26}],"fr":"Votre compagnon (Muhammad) n'est nullement fou;"},{"n":23,"text":"وَلَقَدْ رَءَاهُ بِٱلْأُفُقِ ٱلْمُبِينِ","tajwid":[{"r":"qalqalah","s":6,"e":8},{"r":"hamzat_wasl","s":19,"e":20},{"r":"hamzat_wasl","s":29,"e":30},{"r":"madd_246","s":36,"e":37}],"fr":"il l'a effectivement vu (Gabriel), au clair horizon"},{"n":24,"text":"وَمَا هُوَ عَلَى ٱلْغَيْبِ بِضَنِينٍ","tajwid":[{"r":"hamzat_wasl","s":17,"e":18},{"r":"madd_246","s":33,"e":34}],"fr":"et il ne garde pas avarement pour lui-même ce qui lui a été révélé."},{"n":25,"text":"وَمَا هُوَ بِقَوْلِ شَيْطَٰنٍ رَّجِيمٍ","tajwid":[{"r":"madd_2","s":26,"e":27},{"r":"idghaam_no_ghunnah","s":28,"e":33},{"r":"madd_246","s":35,"e":36}],"fr":"Et ceci [le Coran] n'est point la parole d'un diable banni."},{"n":26,"text":"فَأَيْنَ تَذْهَبُونَ","tajwid":[{"r":"madd_246","s":17,"e":18}],"fr":"Où allez-vous donc?"},{"n":27,"text":"إِنْ هُوَ إِلَّا ذِكْرٌ لِّلْعَٰلَمِينَ","tajwid":[{"r":"idghaam_no_ghunnah","s":22,"e":27},{"r":"madd_2","s":31,"e":32},{"r":"madd_246","s":36,"e":37}],"fr":"Ceci n'est qu'un rappel pour l'univers,"},{"n":28,"text":"لِمَن شَآءَ مِنكُمْ أَن يَسْتَقِيمَ","tajwid":[{"r":"ikhfa","s":4,"e":8},{"r":"madd_muttasil","s":8,"e":10},{"r":"ikhfa","s":15,"e":18},{"r":"idghaam_ghunnah","s":23,"e":27},{"r":"madd_246","s":33,"e":34}],"fr":"pour celui d'entre vous qui veut suivre le chemin droit."},{"n":29,"text":"وَمَا تَشَآءُونَ إِلَّآ أَن يَشَآءَ ٱللَّهُ رَبُّ ٱلْعَٰلَمِينَ","tajwid":[{"r":"madd_muttasil","s":10,"e":12},{"r":"madd_munfasil","s":23,"e":25},{"r":"idghaam_ghunnah","s":28,"e":32},{"r":"madd_muttasil","s":34,"e":36},{"r":"hamzat_wasl","s":39,"e":40},{"r":"hamzat_wasl","s":53,"e":54},{"r":"madd_2","s":58,"e":59},{"r":"madd_246","s":63,"e":64}],"fr":"Mais vous ne pouvez vouloir, que si Allah veut, [Lui], le Seigneur de l'Univers ;"}]}