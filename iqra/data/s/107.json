{"n":107,"ayahs":[{"n":1,"text":"أَرَءَيْتَ ٱلَّذِى يُكَذِّبُ بِٱلدِّينِ","tajwid":[{"r":"hamzat_wasl","s":11,"e":12},{"r":"hamzat_wasl","s":31,"e":32},{"r":"lam_shamsiyyah","s":32,"e":33},{"r":"madd_246","s":36,"e":37}],"fr":"Vois-tu celui qui traite de mensonge la Rétribution?"},{"n":2,"text":"فَذَٰلِكَ ٱلَّذِى يَدُعُّ ٱلْيَتِيمَ","tajwid":[{"r":"madd_2","s":4,"e":5},{"r":"hamzat_wasl","s":10,"e":11},{"r":"hamzat_wasl","s":26,"e":27},{"r":"madd_246","s":33,"e":34}],"fr":"C'est bien lui qui repousse l'orphelin,"},{"n":3,"text":"وَلَا يَحُضُّ عَلَىٰ طَعَامِ ٱلْمِسْكِينِ","tajwid":[{"r":"hamzat_wasl","s":29,"e":30},{"r":"madd_246","s":38,"e":39}],"fr":"et qui n'encourage point à nourrir le pauvre."},{"n":4,"text":"فَوَيْلٌ لِّلْمُصَلِّينَ","tajwid":[{"r":"idghaam_no_ghunnah","s":7,"e":12},{"r":"madd_246","s":21,"e":22}],"fr":"Malheur donc, à ceux qui prient"},{"n":5,"text":"ٱلَّذِينَ هُمْ عَن صَلَاتِهِمْ سَاهُونَ","tajwid":[{"r":"ikhfa","s":17,"e":21},{"r":"madd_246","s":36,"e":37}],"fr":"tout en négligeant (et retardant) leur Salât,"},{"n":6,"text":"ٱلَّذِينَ هُمْ يُرَآءُونَ","tajwid":[{"r":"madd_muttasil","s":19,"e":21},{"r":"madd_246","s":23,"e":24}],"fr":"qui sont pleins d'ostentation,"},{"n":7,"text":"وَيَمْنَعُونَ ٱلْمَاعُونَ","tajwid":[{"r":"hamzat_wasl","s":14,"e":15},{"r":"madd_246","s":22,"e":23}],"fr":"et refusent l'ustensile (à celui qui en a besoin)."}]}