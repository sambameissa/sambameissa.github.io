{"n":87,"ayahs":[{"n":1,"text":"سَبِّحِ ٱسْمَ رَبِّكَ ٱلْأَعْلَى","tajwid":[{"r":"hamzat_wasl","s":8,"e":9},{"r":"hamzat_wasl","s":22,"e":23}],"fr":"Glorifie le nom de ton Seigneur, le Très Haut,"},{"n":2,"text":"ٱلَّذِى خَلَقَ فَسَوَّىٰ","tajwid":[],"fr":"Celui Qui a créé et agencé harmonieusement,"},{"n":3,"text":"وَٱلَّذِى قَدَّرَ فَهَدَىٰ","tajwid":[{"r":"hamzat_wasl","s":2,"e":3}],"fr":"qui a décrété et guidé,"},{"n":4,"text":"وَٱلَّذِىٓ أَخْرَجَ ٱلْمَرْعَىٰ","tajwid":[{"r":"hamzat_wasl","s":2,"e":3},{"r":"madd_munfasil","s":8,"e":10},{"r":"hamzat_wasl","s":20,"e":21}],"fr":"et qui a fait pousser le pâturage,"},{"n":5,"text":"فَجَعَلَهُۥ غُثَآءً أَحْوَىٰ","tajwid":[{"r":"madd_2","s":10,"e":11},{"r":"madd_muttasil","s":16,"e":18}],"fr":"et en a fait ensuite un foin sombre."},{"n":6,"text":"سَنُقْرِئُكَ فَلَا تَنسَىٰٓ","tajwid":[{"r":"qalqalah","s":4,"e":6},{"r":"ikhfa","s":21,"e":24}],"fr":"Nous te ferons réciter (le Coran), de sorte que tu n'oublieras"},{"n":7,"text":"إِلَّا مَا شَآءَ ٱللَّهُ إِنَّهُۥ يَعْلَمُ ٱلْجَهْرَ وَمَا يَخْفَىٰ","tajwid":[{"r":"madd_muttasil","s":13,"e":15},{"r":"hamzat_wasl","s":18,"e":19},{"r":"ghunnah","s":28,"e":31},{"r":"madd_2","s":33,"e":34},{"r":"hamzat_wasl","s":44,"e":45}],"fr":"que ce qu'Allah veut. Car, Il connaît ce qui paraît au grand jour ainsi que ce qui est caché."},{"n":8,"text":"وَنُيَسِّرُكَ لِلْيُسْرَىٰ","tajwid":[],"fr":"Nous te mettrons sur la voie la plus facile."},{"n":9,"text":"فَذَكِّرْ إِن نَّفَعَتِ ٱلذِّكْرَىٰ","tajwid":[{"r":"idghaam_ghunnah","s":12,"e":17},{"r":"hamzat_wasl","s":24,"e":25},{"r":"lam_shamsiyyah","s":25,"e":26}],"fr":"Rappelle, donc, où le Rappel doit être utile."},{"n":10,"text":"سَيَذَّكَّرُ مَن يَخْشَىٰ","tajwid":[{"r":"idghaam_ghunnah","s":15,"e":19}],"fr":"Quiconque craint (Allah) s'[en] rappellera,"},{"n":11,"text":"وَيَتَجَنَّبُهَا ٱلْأَشْقَى","tajwid":[{"r":"ghunnah","s":8,"e":11},{"r":"hamzat_wasl","s":17,"e":18}],"fr":"et s'en écartera le grand malheureux,"},{"n":12,"text":"ٱلَّذِ