{"n":103,"ayahs":[{"n":1,"text":"وَٱلْعَصْرِ","tajwid":[{"r":"hamzat_wasl","s":2,"e":3}],"fr":"Par le Temps!"},{"n":2,"text":"إِنَّ ٱلْإِنسَٰنَ لَفِى خُسْرٍ","tajwid":[{"r":"ghunnah","s":2,"e":5},{"r":"hamzat_wasl","s":6,"e":7},{"r":"ikhfa","s":11,"e":14},{"r":"madd_2","s":14,"e":15}],"fr":"L'homme est certes, en perdition,"},{"n":3,"text":"إِلَّا ٱلَّذِينَ ءَامَنُوا۟ وَعَمِلُوا۟ ٱلصَّٰلِحَٰتِ وَتَوَاصَوْا۟ بِٱلْحَقِّ وَتَوَاصَوْا۟ بِٱلصَّبْرِ","tajwid":[{"r":"hamzat_wasl","s":7,"e":8},{"r":"silent","s":25,"e":27},{"r":"silent","s":37,"e":39},{"r":"hamzat_wasl","s":40,"e":41},{"r":"lam_shamsiyyah","s":41,"e":42},{"r":"madd_2","s":45,"e":46},{"r":"madd_2","s":50,"e":51},{"r":"silent","s":65,"e":67},{"r":"hamzat_wasl","s":70,"e":71},{"r":"silent","s":90,"e":92},{"r":"hamzat_wasl","s":95,"e":96},{"r":"lam_shamsiyyah","s":96,"e":97},{"r":"qalqalah","s":100,"e":102}],"fr":"sauf ceux qui croient et accomplissent les bonnes œuvres, s'enjoignent mutuellement la vérité et s'enjoignent mutuellement l'endurance."}]}