{"n":96,"ayahs":[{"n":1,"text":"ٱقْرَأْ بِٱسْمِ رَبِّكَ ٱلَّذِى خَلَقَ","tajwid":[{"r":"qalqalah","s":1,"e":3},{"r":"hamzat_wasl","s":10,"e":11},{"r":"hamzat_wasl","s":24,"e":25},{"r":"qalqalah","s":36,"e":37}],"fr":"Lis, au nom de ton Seigneur qui a créé,"},{"n":2,"text":"خَلَقَ ٱلْإِنسَٰنَ مِنْ عَلَقٍ","tajwid":[{"r":"hamzat_wasl","s":7,"e":8},{"r":"ikhfa","s":12,"e":15},{"r":"madd_2","s":15,"e":16},{"r":"qalqalah","s":28,"e":29}],"fr":"qui a créé l'homme d'une adhérence."},{"n":3,"text":"ٱقْرَأْ وَرَبُّكَ ٱلْأَكْرَمُ","tajwid":[{"r":"qalqalah","s":1,"e":3},{"r":"hamzat_wasl","s":18,"e":19}],"fr":"Lis! Ton Seigneur est le Très Noble,"},{"n":4,"text":"ٱلَّذِى عَلَّمَ بِٱلْقَلَمِ","tajwid":[{"r":"hamzat_wasl","s":18,"e":19}],"fr":"qui a enseigné par la plume [le calame],"},{"n":5,"text":"عَلَّمَ ٱلْإِنسَٰنَ مَا لَمْ يَعْلَمْ","tajwid":[{"r":"hamzat_wasl","s":8,"e":9},{"r":"ikhfa","s":13,"e":16},{"r":"madd_2","s":16,"e":17}],"fr":"a enseigné à l'homme ce qu'il ne savait pas."},{"n":6,"text":"كَلَّآ إِنَّ ٱلْإِنسَٰنَ لَيَطْغَىٰٓ","tajwid":[{"r":"madd_munfasil","s":5,"e":7},{"r":"ghunnah","s":10,"e":13},{"r":"hamzat_wasl","s":14,"e":15},{"r":"ikhfa","s":19,"e":22},{"r":"madd_2","s":22,"e":23},{"r":"qalqalah","s":30,"e":32}],"fr":"Prenez-garde! Vraiment l'homme devient rebelle,"},{"n":7,"text":"أَن رَّءَاهُ ٱسْتَغْنَىٰٓ","tajwid":[{"r":"idghaam_no_ghunnah","s":2,"e":7},{"r":"hamzat_wasl","s":13,"e":14}],"fr":"dès qu'il estime qu'il peut se suffire à lui-même (à cause de sa richesse)."},{"n":8,"text":"إِنَّ إِلَىٰ رَبِّكَ ٱلرُّجْعَىٰٓ","tajwid":[{"r":"ghunnah","s":2,"e":5},{"r":"hamzat_wasl","s":21,"e":22},{"r":"lam_shamsiyyah","s":22,"e":23},{"r":"qalqalah","s":26,"e":28}],"fr":"Mais, c'est vers ton Seigneur qu'est le retour."},{"n":9,"text":"أَرَءَيْتَ ٱلَّذِى يَنْهَىٰ","tajwid":[{"r":"hamzat_wasl","s":11,"e":12}],"fr":"As-tu vu celui qui interdit"},{"n":10,"text":"عَبْدًا إِذَا صَلَّىٰٓ","tajwid":[{"r":"qalqalah","s":2,"e":4}],"fr":"à un serviteur d'Allah [Muhammad] de célébrer la Salât?"},{"n":11,"text":"أَرَءَيْتَ إِن كَانَ عَلَى ٱلْهُدَىٰٓ","tajwid":[{"r":"ikhfa","s":13,"e":17},{"r":"hamzat_wasl","s":27,"e":28}],"fr":"Vois-tu s'il est sur la bonne voie,"},{"n":12,"text":"أَوْ أَمَرَ بِٱلتَّقْوَىٰٓ","tajwid":[{"r":"hamzat_wasl","s":14,"e":15},{"r":"lam_shamsiyyah","s":15,"e":16},{"r":"qalqalah","s":19,"e":21}],"fr":"ou s'il ordonne la piété?"},{"n":13,"text":"أَرَءَيْتَ إِن كَذَّبَ وَتَوَلَّىٰٓ","tajwid":[{"r":"ikhfa","s":13,"e":17}],"fr":"Vois-tu s'il dément et tourne le dos?"},{"n":14,"text":"أَلَمْ يَعْلَم بِأَنَّ ٱللَّهَ يَرَىٰ","tajwid":[{"r":"ikhfa_shafawi","s":13,"e":17},{"r":"ghunnah","s":19,"e":22},{"r":"hamzat_wasl","s":23,"e":24}],"fr":"Ne sait-il pas que vraiment Allah voit?"},{"n":15,"text":"كَلَّا لَئِن لَّمْ يَنتَهِ لَنَسْفَعًۢا بِٱلنَّاصِيَةِ","tajwid":[{"r":"idghaam_no_ghunnah","s":11,"e":16},{"r":"ikhfa","s":21,"e":24},{"r":"iqlab","s":36,"e":41},{"r":"hamzat_wasl","s":42,"e":43},{"r":"lam_shamsiyyah","s":43,"e":44},{"r":"ghunnah","s":44,"e":47}],"fr":"Mais non! S'il ne cesse pas, Nous le saisirons certes, par le toupet,"},{"n":16,"text":"نَاصِيَةٍ كَٰذِبَةٍ خَاطِئَةٍ","tajwid":[{"r":"ikhfa","s":8,"e":12},{"r":"madd_2","s":12,"e":13}],"fr":"le toupet d'un menteur, d'un pécheur."},{"n":17,"text":"فَلْيَدْعُ نَادِيَهُۥ","tajwid":[{"r":"qalqalah","s":6,"e":8}],"fr":"Qu'il appelle donc son assemblée."},{"n":18,"text":"سَنَدْعُ ٱلزَّبَانِيَةَ","tajwid":[{"r":"qalqalah","s":4,"e":6},{"r":"hamzat_wasl","s":9,"e":10},{"r":"lam_shamsiyyah","s":10,"e":11}],"fr":"Nous appellerons les gardiens [de l'Enfer]."},{"n":19,"text":"كَلَّا لَا تُطِعْهُ وَٱسْجُدْ وَٱقْتَرِب","tajwid":[{"r":"hamzat_wasl","s":22,"e":23},{"r":"qalqalah","s":27,"e":29},{"r":"hamzat_wasl","s":32,"e":33},{"r":"qalqalah","s":33,"e":35},{"r":"qalqalah","s":39,"e":40}],"fr":"Non! Ne lui obéis pas; mais prosterne-toi et rapproche-toi."}]}