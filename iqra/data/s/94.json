{"n":94,"ayahs":[{"n":1,"text":"أَلَمْ نَشْرَحْ لَكَ صَدْرَكَ","tajwid":[{"r":"qalqalah","s":23,"e":25}],"fr":"N'avons-Nous pas ouvert pour toi ta poitrine?"},{"n":2,"text":"وَوَضَعْنَا عَنكَ وِزْرَكَ","tajwid":[{"r":"ikhfa","s":14,"e":17}],"fr":"Et ne t'avons-Nous pas déchargé du fardeau"},{"n":3,"text":"ٱلَّذِىٓ أَنقَضَ ظَهْرَكَ","tajwid":[{"r":"madd_munfasil","s":6,"e":8},{"r":"ikhfa","s":11,"e":14}],"fr":"qui accablait ton dos?"},{"n":4,"text":"وَرَفَعْنَا لَكَ ذِكْرَكَ","tajwid":[],"fr":"Et exalté pour toi ta renommée?"},{"n":5,"text":"فَإِنَّ مَعَ ٱلْعُسْرِ يُسْرًا","tajwid":[{"r":"ghunnah","s":4,"e":7},{"r":"hamzat_wasl","s":13,"e":14}],"fr":"A côté de la difficulté est, certes, une facilité!"},{"n":6,"text":"إِنَّ مَعَ ٱلْعُسْرِ يُسْرًا","tajwid":[{"r":"ghunnah","s":2,"e":5},{"r":"hamzat_wasl","s":11,"e":12}],"fr":"A côté de la difficulté est, certes, une facilité!"},{"n":7,"text":"فَإِذَا فَرَغْتَ فَٱنصَبْ","tajwid":[{"r":"hamzat_wasl","s":19,"e":20},{"r":"ikhfa","s":20,"e":23},{"r":"qalqalah","s":23,"e":25}],"fr":"Quand tu te libères, donc, lève-toi,"},{"n":8,"text":"وَإِلَىٰ رَبِّكَ فَٱرْغَب","tajwid":[{"r":"hamzat_wasl","s":19,"e":20},{"r":"qalqalah","s":24,"e":25}],"fr":"et à ton Seigneur aspire."}]}