{"n":112,"ayahs":[{"n":1,"text":"قُلْ هُوَ ٱللَّهُ أَحَدٌ","tajwid":[{"r":"hamzat_wasl","s":10,"e":11},{"r":"qalqalah","s":22,"e":23}],"fr":"Dis: «Il est Allah, Unique."},{"n":2,"text":"ٱللَّهُ ٱلصَّمَدُ","tajwid":[{"r":"hamzat_wasl","s":8,"e":9},{"r":"lam_shamsiyyah","s":9,"e":10},{"r":"qalqalah","s":15,"e":16}],"fr":"Allah, Le Seul à être imploré pour ce que nous désirons."},{"n":3,"text":"لَمْ يَلِدْ وَلَمْ يُولَدْ","tajwid":[{"r":"qalqalah","s":9,"e":11},{"r":"qalqalah","s":24,"e":26}],"fr":"Il n'a jamais engendré, n'a pas été engendré non plus."},{"n":4,"text":"وَلَمْ يَكُن لَّهُۥ كُفُوًا أَحَدٌۢ","tajwid":[{"r":"idghaam_no_ghunnah","s":11,"e":16},{"r":"madd_2","s":18,"e":19},{"r":"qalqalah","s":32,"e":33}],"fr":"Et nul n'est égal à Lui»."}]}