{"n":102,"ayahs":[{"n":1,"text":"أَلْهَىٰكُمُ ٱلتَّكَاثُرُ","tajwid":[{"r":"madd_2","s":7,"e":8},{"r":"hamzat_wasl","s":13,"e":14},{"r":"lam_shamsiyyah","s":14,"e":15}],"fr":"La course aux richesses vous distrait,"},{"n":2,"text":"حَتَّىٰ زُرْتُمُ ٱلْمَقَابِرَ","tajwid":[{"r":"hamzat_wasl","s":17,"e":18}],"fr":"jusqu'à ce que vous visitiez les tombes."},{"n":3,"text":"كَلَّا سَوْفَ تَعْلَمُونَ","tajwid":[{"r":"madd_246","s":22,"e":23}],"fr":"Mais non! Vous saurez bientôt!"},{"n":4,"text":"ثُمَّ كَلَّا سَوْفَ تَعْلَمُونَ","tajwid":[{"r":"ghunnah","s":2,"e":5},{"r":"madd_246","s":28,"e":29}],"fr":"(Encore une fois)! Vous saurez bientôt!"},{"n":5,"text":"كَلَّا لَوْ تَعْلَمُونَ عِلْمَ ٱلْيَقِينِ","tajwid":[{"r":"hamzat_wasl","s":31,"e":32},{"r":"madd_246","s":38,"e":39}],"fr":"Sûrement! Si vous saviez de science certaine."},{"n":6,"text":"لَتَرَوُنَّ ٱلْجَحِيمَ","tajwid":[{"r":"ghunnah","s":8,"e":11},{"r":"hamzat_wasl","s":12,"e":13},{"r":"madd_246","s":19,"e":20}],"fr":"Vous verrez, certes, la Fournaise."},{"n":7,"text":"ثُمَّ لَتَرَوُنَّهَا عَيْنَ ٱلْيَقِينِ","tajwid":[{"r":"ghunnah","s":2,"e":5},{"r":"ghunnah","s":14,"e":17},{"r":"hamzat_wasl","s":28,"e":29},{"r":"madd_246","s":35,"e":36}],"fr":"Puis, vous la verrez certes, avec l'œil de la certitude."},{"n":8,"text":"ثُمَّ لَتُسْـَٔلُنَّ يَوْمَئِذٍ عَنِ ٱلنَّعِيمِ","tajwid":[{"r":"ghunnah","s":2,"e":5},{"r":"ghunnah","s":17,"e":20},{"r":"hamzat_wasl","s":37,"e":38},{"r":"lam_shamsiyyah","s":38,"e":39},{"r":"ghunnah","s":39,"e":42},{"r":"madd_246","s":44,"e":45}],"fr":"Puis, assurément, vous serez interrogés, ce jour-là, sur les délices."}]}