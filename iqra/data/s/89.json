i»."},{"n":17,"text":"كَلَّا بَل لَّا تُكْرِمُونَ ٱلْيَتِيمَ","tajwid":[{"r":"hamzat_wasl","s":28,"e":29},{"r":"madd_246","s":35,"e":36}],"fr":"Mais non! C'est vous plutôt, qui n'êtes pas généreux envers les orphelins;"},{"n":18,"text":"وَلَا تَحَٰٓضُّونَ عَلَىٰ طَعَامِ ٱلْمِسْكِينِ","tajwid":[{"r":"madd_6","s":10,"e":12},{"r":"hamzat_wasl","s":34,"e":35},{"r":"madd_246","s":43,"e":44}],"fr":"qui ne vous incitez pas mutuellement à nourrir le pauvre,"},{"n":19,"text":"وَتَأْكُلُونَ ٱلتُّرَاثَ أَكْلًا لَّمًّا","tajwid":[{"r":"hamzat_wasl","s":14,"e":15},{"r":"lam_shamsiyyah","s":15,"e":16},{"r":"idghaam_no_ghunnah","s":30,"e":36},{"r":"ghunnah","s":36,"e":39}],"fr":"qui dévorez l'héritage avec une avidité vorace,"},{"n":20,"text":"وَتُحِبُّونَ ٱلْمَالَ حُبًّا جَمًّا","tajwid":[{"r":"hamzat_wasl","s":13,"e":14},{"r":"ikhfa","s":26,"e":31},{"r":"ghunnah","s":31,"e":34}],"fr":"et aimez les richesses d'un amour sans bornes."},{"n":21,"text":"كَلَّآ إِذَا دُكَّتِ ٱلْأَرْضُ دَكًّا دَكًّا","tajwid":[{"r":"madd_munfasil","s":5,"e":7},{"r":"hamzat_wasl","s":22,"e":23},{"r":"ikhfa","s":36,"e":41}],"fr":"Prenez garde! Quand la terre sera complètement pulvérisée,"},{"n":22,"text":"وَجَآءَ رَبُّكَ وَٱلْمَلَكُ صَفًّا صَفًّا","tajwid":[{"r":"madd_muttasil","s":4,"e":6},{"r":"hamzat_wasl","s":19,"e":20},{"r":"ikhfa","s":33,"e":38}],"fr":"et que ton Seigneur viendra ainsi que les Anges, rang par rang,"},{"n":23,"text":"وَجِا۟ىٓءَ يَوْمَئِذٍۭ بِجَهَنَّمَ يَوْمَئِذٍ يَتَذَكَّرُ ٱلْإِنسَٰنُ وَأَنَّىٰ لَهُ ٱلذِّكْرَىٰ","tajwid":[{"r":"silent","s":4,"e":6},{"r":"madd_muttasil","s":6,"e":8},{"r":"iqlab","s":20,"e":24},{"r":"ghunnah","s":29,"e":32},{"r":"idghaam_ghunnah","s":44,"e":48},{"r":"hamzat_wasl","s":58,"e":59},{"r":"ikhfa","s":63,"e":66},{"r":"madd_2","s":66,"e":67},{"r":"ghunnah","s":74,"e":77},{"r":"hamzat_wasl","s":85,"e":86},{"r":"lam_shamsiyyah","s":86,"e":87}],"fr":"et que ce jour-là, on amènera l'Enfer; ce jour-là, l'homme se rappellera. Mais à quoi lui servira de se souvenir?"},{"n":24,"text":"يَقُولُ يَٰلَيْتَنِى قَدَّمْتُ لِحَيَاتِى","tajwid":[{"r":"madd_2","s":10,"e":11}],"fr":"Il dira: «Hélas! Que n'ai-je fait du bien pour ma vie future!"},{"n":25,"text":"فَيَوْمَئِذٍ لَّا يُعَذِّبُ عَذَابَهُۥٓ أَحَدٌ","tajwid":[{"r":"idghaam_no_ghunnah","s":11,"e":16},{"r":"madd_munfasil","s":37,"e":39},{"r":"qalqalah","s":44,"e":45}],"fr":"Ce jour-là donc, nul ne saura châtier comme Lui châtie,"},{"n":26,"text":"وَلَا يُوثِقُ وَثَاقَهُۥٓ أَحَدٌ","tajwid":[{"r":"madd_munfasil","s":23,"e":25},{"r":"qalqalah","s":30,"e":31}],"fr":"et nul ne saura garrotter comme Lui garrotte."},{"n":27,"text":"يَٰٓأَيَّتُهَا ٱلنَّفْسُ ٱلْمُطْمَئِنَّةُ","tajwid":[{"r":"madd_munfasil","s":2,"e":4},{"r":"hamzat_wasl","s":15,"e":16},{"r":"lam_shamsiyyah","s":16,"e":17},{"r":"ghunnah","s":17,"e":20},{"r":"hamzat_wasl","s":25,"e":26},{"r":"qalqalah","s":30,"e":32},{"r":"ghunnah","s":36,"e":39}],"fr":"«O toi, âme apaisée,"},{"n":28,"text":"ٱرْجِعِىٓ إِلَىٰ رَبِّكِ رَاضِيَةً مَّرْضِيَّةً","tajwid":[{"r":"madd_munfasil","s":7,"e":9},{"r":"idghaam_ghunnah","s":33,"e":38}],"fr":"retourne vers ton Seigneur, satisfaite et agréée;"},{"n":29,"text":"فَٱدْخُلِى فِى عِبَٰدِى","tajwid":[{"r":"hamzat_wasl","s":2,"e":3},{"r":"qalqalah","s":3,"e":5},{"r":"madd_2","s":19,"e":20}],"fr":"entre donc parmi Mes serviteurs,"},{"n":30,"text":"وَٱدْخُلِى جَنَّتِى","tajwid":[{"r":"hamzat_wasl","s":2,"e":3},{"r":"qalqalah","s":3,"e":5},{"r":"ghunnah","s":13,"e":16}],"fr":"et entre dans Mon Paradis»."}]}