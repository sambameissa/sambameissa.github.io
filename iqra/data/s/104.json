{"n":104,"ayahs":[{"n":1,"text":"وَيْلٌ لِّكُلِّ هُمَزَةٍ لُّمَزَةٍ","tajwid":[{"r":"idghaam_no_ghunnah","s":5,"e":10},{"r":"idghaam_no_ghunnah","s":23,"e":28}],"fr":"Malheur à tout calomniateur diffamateur,"},{"n":2,"text":"ٱلَّذِى جَمَعَ مَالًا وَعَدَّدَهُۥ","tajwid":[{"r":"idghaam_ghunnah","s":19,"e":24}],"fr":"qui amasse une fortune et la compte,"},{"n":3,"text":"يَحْسَبُ أَنَّ مَالَهُۥٓ أَخْلَدَهُۥ","tajwid":[{"r":"ghunnah","s":11,"e":14},{"r":"madd_munfasil","s":22,"e":24}],"fr":"pensant que sa fortune l'immortalisera."},{"n":4,"text":"كَلَّا لَيُنۢبَذَنَّ فِى ٱلْحُطَمَةِ","tajwid":[{"r":"iqlab","s":12,"e":14},{"r":"ghunnah","s":17,"e":20},{"r":"hamzat_wasl","s":25,"e":26}],"fr":"Mais non! Il sera certes, jeté dans la Hutamah."},{"n":5,"text":"وَمَآ أَدْرَىٰكَ مَا ٱلْحُطَمَةُ","tajwid":[{"r":"madd_munfasil","s":4,"e":6},{"r":"qalqalah","s":9,"e":11},{"r":"madd_2","s":14,"e":15},{"r":"hamzat_wasl","s":22,"e":23}],"fr":"Et qui te dira ce qu'est la Hutamah?"},{"n":6,"text":"نَارُ ٱللَّهِ ٱلْمُوقَدَةُ","tajwid":[{"r":"hamzat_wasl","s":6,"e":7},{"r":"hamzat_wasl","s":14,"e":15}],"fr":"Le Feu attisé d'Allah"},{"n":7,"text":"ٱلَّتِى تَطَّلِعُ عَلَى ٱلْأَفْـِٔدَةِ","tajwid":[{"r":"hamzat_wasl","s":24,"e":25}],"fr":"qui monte jusqu'aux cœurs."},{"n":8,"text":"إِنَّهَا عَلَيْهِم مُّؤْصَدَةٌ","tajwid":[{"r":"ghunnah","s":2,"e":5},{"r":"idghaam_shafawi","s":17,"e":22}],"fr":"Il se refermera sur eux,"},{"n":9,"text":"فِى عَمَدٍ مُّمَدَّدَةٍۭ","tajwid":[{"r":"idghaam_ghunnah","s":9,"e":14}],"fr":"en colonnes (de flammes) étendues."}]}