{"n":82,"ayahs":[{"n":1,"text":"إِذَا ٱلسَّمَآءُ ٱنفَطَرَتْ","tajwid":[{"r":"hamzat_wasl","s":6,"e":7},{"r":"lam_shamsiyyah","s":7,"e":8},{"r":"madd_muttasil","s":13,"e":15},{"r":"hamzat_wasl","s":18,"e":19},{"r":"ikhfa","s":19,"e":22}],"fr":"Quand le ciel se rompra,"},{"n":2,"text":"وَإِذَا ٱلْكَوَاكِبُ ٱنتَثَرَتْ","tajwid":[{"r":"hamzat_wasl","s":8,"e":9},{"r":"hamzat_wasl","s":21,"e":22},{"r":"ikhfa","s":22,"e":25}],"fr":"et que les étoiles se disperseront,"},{"n":3,"text":"وَإِذَا ٱلْبِحَارُ فُجِّرَتْ","tajwid":[{"r":"hamzat_wasl","s":8,"e":9}],"fr":"et que les mers confondront leurs eaux,"},{"n":4,"text":"وَإِذَا ٱلْقُبُورُ بُعْثِرَتْ","tajwid":[{"r":"hamzat_wasl","s":8,"e":9}],"fr":"et que les tombeaux seront bouleversés,"},{"n":5,"text":"عَلِمَتْ نَفْسٌ مَّا قَدَّمَتْ وَأَخَّرَتْ","tajwid":[{"r":"idghaam_ghunnah","s":14,"e":19}],"fr":"toute âme saura alors ce qu'elle a accompli et ce qu'elle a remis de faire à plus tard."},{"n":6,"text":"يَٰٓأَيُّهَا ٱلْإِنسَٰنُ مَا غَرَّكَ بِرَبِّكَ ٱلْكَرِيمِ","tajwid":[{"r":"madd_munfasil","s":2,"e":4},{"r":"hamzat_wasl","s":13,"e":14},{"r":"ikhfa","s":18,"e":21},{"r":"madd_2","s":21,"e":22},{"r":"hamzat_wasl","s":47,"e":48},{"r":"madd_246","s":54,"e":55}],"fr":"O homme! Qu'est-ce qui t'a trompé au sujet de ton Seigneur, le Noble,"},{"n":7,"text":"ٱلَّذِى خَلَقَكَ فَسَوَّىٰكَ فَعَدَلَكَ","tajwid":[{"r":"madd_2","s":25,"e":26}],"fr":"qui t'a créé, puis modelé et constitué harmonieusement?"},{"n":8,"text":"فِىٓ أَىِّ صُورَةٍ مَّا شَآءَ رَكَّبَكَ","tajwid":[{"r":"madd_munfasil","s":2,"e":4},{"r":"idghaam_ghunnah","s":17,"e":22},{"r":"madd_muttasil","s":26,"e":28}],"fr":"Il t'a façonné dans la forme qu'Il a voulue."},{"n":9,"text":"كَلَّا بَلْ تُكَذِّبُونَ بِٱلدِّينِ","tajwid":[{"r":"hamzat_wasl","s":27,"e":28},{"r":"lam_shamsiyyah","s":28,"e":29},{"r":"madd_246","s":32,"e":33}],"fr":"Non...! [malgré tout] vous traitez la Rétribution de mensonge;"},{"n":10,"text":"وَإِنَّ عَلَيْكُمْ لَحَٰفِظِينَ","tajwid":[{"r":"ghunnah","s":4,"e":7},{"r":"madd_2","s":23,"e":24},{"r":"madd_246","s":28,"e":29}],"fr":"alors que veillent sur vous des gardiens,"},{"n":11,"text":"كِرَامًا كَٰتِبِينَ","tajwid":[{"r":"ikhfa","s":6,"e":11},{"r":"madd_2","s":11,"e":12},{"r":"madd_246","s":16,"e":17}],"fr":"de nobles scribes,"},{"n":12,"text":"يَعْلَمُونَ مَا تَفْعَلُونَ","tajwid":[{"r":"madd_246","s":24,"e":25}],"fr":"qui savent ce que vous faites."},{"n":13,"text":"إِنَّ ٱلْأَبْرَارَ لَفِى نَعِيمٍ","tajwid":[{"r":"ghunnah","s":2,"e":5},{"r":"hamzat_wasl","s":6,"e":7},{"r":"qalqalah","s":11,"e":13},{"r":"madd_246","s":29,"e":30}],"fr":"Les bons seront, certes, dans un [jardin] de délice,"},{"n":14,"text":"وَإِنَّ ٱلْفُجَّارَ لَفِى جَحِيمٍ","tajwid":[{"r":"ghunnah","s":4,"e":7},{"r":"hamzat_wasl","s":8,"e":9},{"r":"madd_246","s":30,"e":31}],"fr":"et les libertins seront, certes, dans une fournaise"},{"n":15,"text":"يَصْلَوْنَهَا يَوْمَ ٱلدِّينِ","tajwid":[{"r":"hamzat_wasl","s":21,"e":22},{"r":"lam_shamsiyyah","s":22,"e":23},{"r":"madd_246","s":26,"e":27}],"fr":"où ils brûleront, le jour de la Rétribution"},{"n":16,"text":"وَمَا هُمْ عَنْهَا بِغَآئِبِينَ","tajwid":[{"r":"madd_muttasil","s":23,"e":25},{"r":"madd_246","s":29,"e":30}],"fr":"incapables de s'en échapper."},{"n":17,"text":"وَمَآ أَدْرَىٰكَ مَا يَوْمُ ٱلدِّينِ","tajwid":[{"r":"madd_munfasil","s":4,"e":6},{"r":"qalqalah","s":9,"e":11},{"r":"madd_2","s":14,"e":15},{"r":"hamzat_wasl","s":29,"e":30},{"r":"lam_shamsiyyah","s":30,"e":31},{"r":"madd_246","s":34,"e":35}],"fr":"Et qui te dira ce qu'est le jour de la Rétribution?"},{"n":18,"text":"ثُمَّ مَآ أَدْرَىٰكَ مَا يَوْمُ ٱلدِّينِ","tajwid":[{"r":"ghunnah","s":2,"e":5},{"r":"madd_munfasil","s":8,"e":10},{"r":"qalqalah","s":13,"e":15},{"r":"madd_2","s":18,"e":19},{"r":"hamzat_wasl","s":33,"e":34},{"r":"lam_shamsiyyah","s":34,"e":35},{"r":"madd_246","s":38,"e":39}],"fr":"Encore une fois, qui te dira ce qu'est le jour de la Rétribution?"},{"n":19,"text":"يَوْمَ لَا تَمْلِكُ نَفْسٌ لِّنَفْسٍ شَيْـًٔا وَٱلْ