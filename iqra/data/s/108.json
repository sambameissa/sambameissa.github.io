{"n":108,"ayahs":[{"n":1,"text":"إِنَّآ أَعْطَيْنَٰكَ ٱلْكَوْثَرَ","tajwid":[{"r":"ghunnah","s":2,"e":5},{"r":"madd_munfasil","s":5,"e":7},{"r":"madd_2","s":18,"e":19},{"r":"hamzat_wasl","s":22,"e":23}],"fr":"Nous t'avons certes, accordé l'Abondance."},{"n":2,"text":"فَصَلِّ لِرَبِّكَ وَٱنْحَرْ","tajwid":[{"r":"hamzat_wasl","s":20,"e":21}],"fr":"Accomplis la Salât pour ton Seigneur et sacrifie."},{"n":3,"text":"إِنَّ شَانِئَكَ هُوَ ٱلْأَبْتَرُ","tajwid":[{"r":"ghunnah","s":2,"e":5},{"r":"hamzat_wasl","s":21,"e":22},{"r":"qalqalah","s":26,"e":28}],"fr":"Celui qui te hait sera certes, sans postérité."}]}