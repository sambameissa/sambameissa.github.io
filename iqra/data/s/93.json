{"n":93,"ayahs":[{"n":1,"text":"وَٱلضُّحَىٰ","tajwid":[{"r":"hamzat_wasl","s":2,"e":3},{"r":"lam_shamsiyyah","s":3,"e":4}],"fr":"Par le Jour Montant!"},{"n":2,"text":"وَٱلَّيْلِ إِذَا سَجَىٰ","tajwid":[{"r":"hamzat_wasl","s":2,"e":3}],"fr":"Et par la nuit quand elle couvre tout!"},{"n":3,"text":"مَا وَدَّعَكَ رَبُّكَ وَمَا قَلَىٰ","tajwid":[],"fr":"Ton Seigneur ne t'a ni abandonné, ni détesté."},{"n":4,"text":"وَلَلْءَاخِرَةُ خَيْرٌ لَّكَ مِنَ ٱلْأُولَىٰ","tajwid":[{"r":"idghaam_no_ghunnah","s":21,"e":26},{"r":"hamzat_wasl","s":34,"e":35}],"fr":"La vie dernière t'est, certes, meilleure que la vie présente."},{"n":5,"text":"وَلَسَوْفَ يُعْطِيكَ رَبُّكَ فَتَرْضَىٰٓ","tajwid":[],"fr":"Ton Seigneur t'accordera certes [Ses faveurs], et alors tu seras satisfait."},{"n":6,"text":"أَلَمْ يَجِدْكَ يَتِيمًا فَـَٔاوَىٰ","tajwid":[{"r":"qalqalah","s":11,"e":13},{"r":"ikhfa","s":22,"e":27}],"fr":"Ne t'a-t-Il pas trouvé orphelin? Alors Il t'a accueilli!"},{"n":7,"text":"وَوَجَدَكَ ضَآلًّا فَهَدَىٰ","tajwid":[{"r":"madd_6","s":13,"e":15},{"r":"ikhfa","s":17,"e":22}],"fr":"Ne t'a-t-Il pas trouvé égaré? Alors Il t'a guidé."},{"n":8,"text":"وَوَجَدَكَ عَآئِلًا فَأَغْنَىٰ","tajwid":[{"r":"madd_muttasil","s":13,"e":15},{"r":"ikhfa","s":18,"e":23}],"fr":"Ne t'a-t-Il pas trouvé pauvre? Alors Il t'a enrichi."},{"n":9,"text":"فَأَمَّا ٱلْيَتِيمَ فَلَا تَقْهَرْ","tajwid":[{"r":"ghunnah","s":4,"e":7},{"r":"hamzat_wasl","s":9,"e":10},{"r":"qalqalah","s":28,"e":30}],"fr":"Quant à l'orphelin, donc, ne le maltraite pas."},{"n":10,"text":"وَأَمَّا ٱلسَّآئِلَ فَلَا تَنْهَرْ","tajwid":[{"r":"ghunnah","s":4,"e":7},{"r":"hamzat_wasl","s":9,"e":10},{"r":"lam_shamsiyyah","s":10,"e":11},{"r":"madd_muttasil","s":14,"e":16}],"fr":"Quant au demandeur, ne le repousse pas."},{"n":11,"text":"وَأَمَّا بِنِعْمَةِ رَبِّكَ فَحَدِّثْ","tajwid":[{"r":"ghunnah","s":4,"e":7}],"fr":"Et quant au bienfait de ton Seigneur, proclame-le."}]}