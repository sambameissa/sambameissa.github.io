{"n":111,"ayahs":[{"n":1,"text":"تَبَّتْ يَدَآ أَبِى لَهَبٍ وَتَبَّ","tajwid":[{"r":"madd_munfasil","s":12,"e":14},{"r":"idghaam_ghunnah","s":26,"e":30},{"r":"qalqalah","s":32,"e":33}],"fr":"Que périssent les deux mains d'Abû-Lahab et que lui-même périsse."},{"n":2,"text":"مَآ أَغْنَىٰ عَنْهُ مَالُهُۥ وَمَا كَسَبَ","tajwid":[{"r":"madd_munfasil","s":2,"e":4},{"r":"madd_2","s":28,"e":29},{"r":"qalqalah","s":40,"e":41}],"fr":"Sa fortune ne lui sert à rien, ni ce qu'il a acquis."},{"n":3,"text":"سَيَصْلَىٰ نَارًا ذَاتَ لَهَبٍ","tajwid":[{"r":"ikhfa","s":15,"e":20},{"r":"qalqalah","s":28,"e":29}],"fr":"Il sera brûlé dans un Feu plein de flammes,"},{"n":4,"text":"وَٱمْرَأَتُهُۥ حَمَّالَةَ ٱلْحَطَبِ","tajwid":[{"r":"hamzat_wasl","s":2,"e":3},{"r":"madd_2","s":13,"e":14},{"r":"ghunnah","s":17,"e":20},{"r":"hamzat_wasl","s":26,"e":27},{"r":"qalqalah","s":33,"e":34}],"fr":"de même sa femme, la porteuse de bois,"},{"n":5,"text":"فِى جِيدِهَا حَبْلٌ مِّن مَّسَدٍۭ","tajwid":[{"r":"qalqalah","s":15,"e":17},{"r":"idghaam_ghunnah","s":18,"e":23},{"r":"idghaam_ghunnah","s":23,"e":28},{"r":"qalqalah","s":30,"e":31}],"fr":"à son cou, une corde de fibres."}]}