{"n":80,"ayahs":[{"n":1,"text":"عَبَسَ وَتَوَلَّىٰٓ","tajwid":[],"fr":"Il s'est renfrogné et il s'est détourné"},{"n":2,"text":"أَن جَآءَهُ ٱلْأَعْمَىٰ","tajwid":[{"r":"ikhfa","s":2,"e":6},{"r":"madd_muttasil","s":6,"e":8},{"r":"hamzat_wasl","s":13,"e":14}],"fr":"parce que l'aveugle est venu à lui."},{"n":3,"text":"وَمَا يُدْرِيكَ لَعَلَّهُۥ يَزَّكَّىٰٓ","tajwid":[{"r":"qalqalah","s":8,"e":10},{"r":"madd_2","s":25,"e":26}],"fr":"Qui te dit: peut-être [cherche]-t-il à se purifier?"},{"n":4,"text":"أَوْ يَذَّكَّرُ فَتَنفَعَهُ ٱلذِّكْرَىٰٓ","tajwid":[{"r":"ikhfa","s":20,"e":23},{"r":"hamzat_wasl","s":28,"e":29},{"r":"lam_shamsiyyah","s":29,"e":30}],"fr":"ou à se rappeler en sorte que le rappel lui profite?"},{"n":5,"text":"أَمَّا مَنِ ٱسْتَغْنَىٰ","tajwid":[{"r":"ghunnah","s":2,"e":5},{"r":"hamzat_wasl","s":12,"e":13}],"fr":"Quant à celui qui se complaît dans sa suffisance (pour sa richesse)"},{"n":6,"text":"فَأَنتَ لَهُۥ تَصَدَّىٰ","tajwid":[{"r":"ikhfa","s":4,"e":7},{"r":"madd_2","s":12,"e":13}],"fr":"tu vas avec empressement à sa rencontre."},{"n":7,"text":"وَمَا عَلَيْكَ أَلَّا يَزَّكَّىٰ","tajwid":[],"fr":"Or, que t'importe qu'il ne se purifie pas»."},{"n":8,"text":"وَأَمَّا مَن جَآءَكَ يَسْعَىٰ","tajwid":[{"r":"ghunnah","s":4,"e":7},{"r":"ikhfa","s":11,"e":15},{"r":"madd_muttasil","s":15,"e":17}],"fr":"Et quant à celui qui vient à toi avec empressement"},{"n":9,"text":"وَهُوَ يَخْشَىٰ","tajwid":[],"fr":"tout en ayant la crainte,"},{"n":10,"text":"فَأَنتَ عَنْهُ تَلَهَّىٰ","tajwid":[{"r":"ikhfa","s":4,"e":7}],"fr":"tu ne t'en soucies pas."},{"n":11,"text":"كَلَّآ إِنَّهَا تَذْكِرَةٌ","tajwid":[{"r":"madd_munfasil","s":5,"e":7},{"r":"ghunnah","s":10,"e":13}],"fr":"N'agis plus ainsi! Vraiment ceci est un rappel -"},{"n":12,"text":"فَمَن شَآءَ ذَكَرَهُۥ","tajwid":[{"r":"ikhfa","s":4,"e":8},{"r":"madd_muttasil","s":8,"e":10}],"fr":"quiconque veut, donc, s'en rappelle -"},{"n":13,"text":"فِى صُحُفٍ مُّكَرَّمَةٍ","tajwid":[{"r":"idghaam_ghunnah","s":9,"e":14}],"fr":