"text":"لِكُلِّ ٱمْرِئٍ مِّنْهُمْ يَوْمَئِذٍ شَأْنٌ يُغْنِيهِ","tajwid":[{"r":"hamzat_wasl","s":8,"e":9},{"r":"idghaam_ghunnah","s":14,"e":19},{"r":"ikhfa","s":35,"e":39},{"r":"idghaam_ghunnah","s":42,"e":46},{"r":"madd_246","s":50,"e":51}],"fr":"car chacun d'eux, ce jour-là, aura son propre cas pour l'occuper."},{"n":38,"text":"وُجُوهٌ يَوْمَئِذٍ مُّسْفِرَةٌ","tajwid":[{"r":"idghaam_ghunnah","s":6,"e":10},{"r":"idghaam_ghunnah","s":17,"e":22}],"fr":"Ce jour-là, il y aura des visages rayonnants,"},{"n":39,"text":"ضَاحِكَةٌ مُّسْتَبْشِرَةٌ","tajwid":[{"r":"idghaam_ghunnah","s":8,"e":13},{"r":"qalqalah","s":17,"e":19}],"fr":"riants et réjouis."},{"n":40,"text":"وَوُجُوهٌ يَوْمَئِذٍ عَلَيْهَا غَبَرَةٌ","tajwid":[{"r":"idghaam_ghunnah","s":8,"e":12}],"fr":"De même qu'il y aura, ce jour-là, des visages couverts de poussière,"},{"n":41,"text":"تَرْهَقُهَا قَتَرَةٌ","tajwid":[],"fr":"recouverts de ténèbres."},{"n":42,"text":"أُو۟لَٰٓئِكَ هُمُ ٱلْكَفَرَةُ ٱلْفَجَرَةُ","tajwid":[{"r":"silent","s":2,"e":4},{"r":"madd_muttasil","s":6,"e":8},{"r":"hamzat_wasl","s":18,"e":19},{"r":"hamzat_wasl","s":30,"e":31}],"fr":"Voilà les infidèles, les libertins."}]}